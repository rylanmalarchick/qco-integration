# QCO-Integration Environment Configuration
# Copy this file to .env and fill in actual values

# =============================================================================
# External Binary Paths
# =============================================================================

# Path to quantum-circuit-optimizer C++ binary
# Build location: <qco-path>/build/quantum_circuit_optimizer
QCO_OPTIMIZER_BINARY=/home/rylan/Documents/career/code_bases/quantum/compilers/quantum-circuit-optimizer/build/quantum_circuit_optimizer

# Path to QubitPulseOpt installation (for GateCompiler import)
# This should be the directory containing the qubit_pulse_opt package
QUBIT_PULSE_OPT_PATH=/home/rylan/Documents/career/code_bases/quantum/Controls/QubitPulseOpt

# =============================================================================
# Experiment Configuration
# =============================================================================

# Default target topology
DEFAULT_TOPOLOGY=iqm-garnet

# Results output directory (relative to project root)
RESULTS_DIR=results

# Enable parallel execution (0 or 1)
PARALLEL_EXECUTION=0

# =============================================================================
# Noise Model Defaults (IQM Garnet median values)
# =============================================================================

# T1 relaxation time in nanoseconds (median: ~37000 ns)
DEFAULT_T1_NS=37000

# T2 dephasing time in nanoseconds (median: ~9600 ns)
DEFAULT_T2_NS=9600

# Single-qubit gate error (median: ~0.001)
DEFAULT_1Q_ERROR=0.001

# Two-qubit gate error (median: ~0.006)
DEFAULT_2Q_ERROR=0.006

# =============================================================================
# Validation Level (AgentBible)
# =============================================================================
# Options: debug (full validation), lite (NaN/Inf only), off (DANGEROUS)
AGENTBIBLE_VALIDATION_LEVEL=debug
